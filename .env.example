# My Open Dataspace — configuracion del nodo
#
# Este es el unico sitio donde se configura nada. `./install.sh` escribe un
# .env a partir de este fichero, genera las contrasenas que falten y levanta
# la composicion. Si prefieres hacerlo a mano: copia este fichero a .env,
# rellena lo de arriba y ejecuta `docker compose up -d`.
#
# El .env no se versiona. El .env.example si.

# Identidad del despliegue
ODS_ORG_NAME="Mi Organización"
ODS_ORG_ID="mi-organizacion"
ODS_ADMIN_EMAIL="admin@mi-organizacion.example"
ODS_ADMIN_PASSWORD=""            # vacío = se genera y se imprime al terminar
ODS_LANG="es"                    # es | en

# Publicación
ODS_DOMAIN=""                    # vacío = modo local en http://localhost:8080
ODS_PUBLIC_URL="http://localhost:8080"
ODS_TLS="auto"                   # auto | off

# Conector
ODS_CONNECTOR_ID="connector"
ODS_DOWNLOAD_ALLOWED_HOSTS="localhost"

# Infraestructura
ODS_DB_PASSWORD=""               # vacío = se genera
ODS_KEYCLOAK_ADMIN_PASSWORD=""   # vacío = se genera

# Catálogo federado
ODS_FEDERATION_INTERVAL="300"    # segundos entre sincronizaciones
ODS_SPARQL_PUBLIC="false"        # true = punto SPARQL de sólo lectura abierto

# Arranque
ODS_SEED_DEMO="true"             # publica un producto de datos de ejemplo

# ---------------------------------------------------------------------------
# Lo de aquí abajo tiene valor por omisión y casi nunca hace falta tocarlo.
# ---------------------------------------------------------------------------

# Almacén RDF
ODS_FUSEKI_ADMIN_PASSWORD=""     # vacío = se genera

# Identidad
ODS_REALM="dataspace"
ODS_AUTH_URL=""                  # vacío = <ODS_PUBLIC_URL>/auth

# Puertos de la máquina anfitriona. Cámbialos si 8080 u 8443 están ocupados.
ODS_HTTP_PORT="8080"
ODS_HTTPS_PORT="8443"

# Marca. El asistente de primer arranque escribe estos por ti.
ODS_BRAND_COLOR="#1f5fd0"
ODS_LOGO_PATH=""
ODS_ICON_PATH=""
ODS_BRAND_MARK_PATH=""
ODS_LEGAL_NOTICE=""

# Avisos por correo. Sin servidor configurado el nodo no envía nada y lo dice
# en la consola en vez de fallar en silencio.
ODS_SMTP_HOST=""
ODS_SMTP_PORT="587"
ODS_SMTP_USER=""
ODS_SMTP_PASSWORD=""
ODS_SMTP_STARTTLS="true"
ODS_SMTP_FROM=""                 # vacío = ODS_ADMIN_EMAIL

# Imágenes. Se cambian para actualizar: pon la etiqueta que quieras y vuelve
# a levantar. Con el valor de desarrollo, la composición construye en local.
ODS_IMAGE_APP="myopendataspace/app:dev"
ODS_IMAGE_CONNECTOR="myopendataspace/connector:dev"
